# --- training / serving artifacts (weights stay local or release as GitHub Release assets)
*.pt
*.safetensors
*.bin
tokenizer.json.orig
slm-ft/merged_fp16/
slm-ft/adapter/
slm-ft/adapter_stage2/
slm-ft/data/
# evaluate_ft.py writes to Path(--out_dir or --adapter); a baseline run with
# --adapter none recreates this directory. Keep it out of the repo.
slm-ft/none/
slm-training/samples/
slm-training/evaluation_output/
# slm-training/empathetic_run/ is intentionally NOT ignored: *.pt, *.bin and
# *.log above already exclude its heavy artifacts, and its small run records
# (training_stats.json, losses.json, training_config.json) are the evidence
# behind the documented validation perplexity.

# --- logs ----------------------------------------------------------------
*.log
logs/

# --- misc build/test artifacts -------------------------------------------
coverage/
dist/
build/
pgdata/
