# Auto-detect text files and normalize line endings
* text=auto

# Ensure shell scripts use LF
*.sh text eol=lf

# Ensure Python files use LF
*.py text eol=lf

# Ensure YAML files use LF
*.yml text eol=lf
*.yaml text eol=lf

# Ensure JSON files use LF
*.json text eol=lf

# Ensure Markdown files use LF
*.md text eol=lf

# Ensure TOML files use LF
*.toml text eol=lf

# Binary files - do not diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pt binary
*.bin binary
*.safetensors binary
*.onnx binary
*.h5 binary
*.pb binary

# Large files - prevent accidental commits
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.whl filter=lfs diff=lfs merge=lfs -text
