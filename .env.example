# SLM Project Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# Model Paths
# ============================================
SLM_CHECKPOINT=slm-training/best_model.pt
QWEN_MERGED_DIR=slm-ft/merged_fp16
QWEN_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# ============================================
# Inference Server
# ============================================
MODEL_DEVICE=cpu
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me-to-a-real-key
LOG_LEVEL=INFO

# ============================================
# Inference Server - Runtime Limits
# ============================================
# RATE_LIMIT uses limits(7) syntax, e.g. "60/minute", "1000/hour",
# "10/second". Applies per client IP to every generation endpoint.
RATE_LIMIT=60/minute
# Comma-separated list of allowed origins, or "*" for any origin.
CORS_ORIGINS=*
# Seconds before an in-flight request is cancelled and the client
# receives HTTP 504.
REQUEST_TIMEOUT=30

# ============================================
# Benchmarking
# ============================================
BENCH_MAX_NEW_TOKENS=80
BENCH_TEMPERATURE=0.7
BENCH_TOP_K=20
BENCH_PROMPTS_FILE=prompts.txt
BENCH_SEED=1337

# ============================================
# Training (if retraining from scratch)
# ============================================
TRAIN_SEED=1337
TRAIN_BATCH_SIZE=4
TRAIN_LEARNING_RATE=0.0001
TRAIN_MAX_STEPS=10000
TRAIN_CONTEXT_LEN=256
