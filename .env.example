# Emotional SLM — environment template.
# Copy to `.env` and fill in. Every key here maps 1:1 to a setting in
# backend/core/config.py (extra keys are ignored by pydantic-settings).
# Never commit a real `.env` — it is git-ignored.

# --- core -----------------------------------------------------------------
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://slm:slm@localhost:5432/slm
REDIS_URL=redis://localhost:6379/0
# Empty in dev -> per-process random secret (with a warning). Production startup
# fails fast unless a strong secret is configured. REQUIRED outside development.
JWT_SECRET=
# Allow-listed signing algorithm. Only HS256 is supported today; do not change.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- model gateway tiers ---------------------------------------------------
HF_API_TOKEN=
HF_MODEL_URL=
HF_FALLBACK_MODEL_URL=
HF_FALLBACK_MODEL_NAME=fallback
HF_CANARY_MODEL_URL=
HF_CANARY_MODEL_NAME=canary
HF_FAST_MODEL_URL=
HF_FAST_MODEL_NAME=fast
HF_QUALITY_MODEL_URL=
HF_QUALITY_MODEL_NAME=quality
# Locally-served fine-tuned model (slm-ft/serve_model.py); leave empty to disable
SERVED_MODEL_URL=
SERVE_MODEL_TOKEN=
# In-process local GPT artifact (slm-training/best_model.pt). Opt-in, toy-scale;
# leave disabled for real chat.
LOCAL_TORCH_MODEL_ENABLED=false
LOCAL_TORCH_MODEL_PATH=
CANARY_TRAFFIC_PERCENT=0
INFERENCE_TIMEOUT_SECONDS=30
INFERENCE_MAX_ATTEMPTS=2
GATEWAY_CB_COOLDOWN_SECONDS=60
GATEWAY_POLICY_VERSION=1
INFERENCE_PROVIDER=stub
INFERENCE_MODEL_NAME=emotional-slm-stub
INFERENCE_TEMPERATURE=0.7
INFERENCE_TOP_P=0.9
INFERENCE_REPETITION_PENALTY=1.08
MAX_COMPLETION_TOKENS=256
MIN_COMPLETION_TOKENS=64
MAX_USER_MESSAGE_TOKENS_ESTIMATE=8000
TOKEN_BUDGET_PER_USER_DAILY=0

# --- safety pipeline -------------------------------------------------------
# fail_closed=true: when a configured safety provider errors, block (score 0)
# instead of passing. Local regex backstops always run regardless.
SAFETY_FAIL_CLOSED=true
# Score thresholds for the optional HF input/output classifiers.
SAFETY_INPUT_THRESHOLD=0.5
SAFETY_OUTPUT_THRESHOLD=0.5
SAFETY_INPUT_HF_URL=
SAFETY_OUTPUT_HF_URL=
SAFETY_SELF_HARM_THRESHOLD=0.50
SAFETY_VIOLENCE_THRESHOLD=0.60
SAFETY_ABUSE_THRESHOLD=0.60
SAFETY_MEDICAL_EMERGENCY_THRESHOLD=0.55
SAFETY_PROMPT_INJECTION_THRESHOLD=0.70
CRISIS_HUMAN_REVIEW_ENABLED=false
SAFETY_RULESET_VERSION=1
PROMPT_VERSION=1

# --- emotion inference -----------------------------------------------------
EMOTION_HF_URL=
# HF text-classification model id used when EMOTION_HF_URL points at a router.
EMOTION_HF_MODEL=j-hartmann/emotion-english-distilroberta-base
EMOTION_MIN_CONFIDENCE=0.60
EMOTION_ENGLISH_ONLY=true
EMOTION_CACHE_ENABLED=true
EMOTION_CACHE_TTL_SECONDS=300

# --- memory (opt-in) -------------------------------------------------------
MEMORY_ENABLED=false
MEMORY_PI_REDACT=true
MEMORY_CHUNK_TTL_DAYS=365
# Embedding dimensionality expected from HF_EMBEDDING_URL.
MEMORY_EMBEDDING_DIM=384
MEMORY_SIMILARITY_WEIGHT=0.75
MEMORY_RECENCY_WEIGHT=0.25
HF_EMBEDDING_URL=

# --- routing / chat --------------------------------------------------------
CHAT_HISTORY_LIMIT=16
ROUTER_SIMPLE_TURN_MAX_CHARS=220
ROUTER_SIMPLE_TURN_MAX_LINES=3
ROUTER_COMPLEX_TURN_MIN_CHARS=900
ROUTER_COMPLEX_TURN_MIN_LINES=12
WS_MESSAGE_MAX_CHARS=32000
IDEMPOTENCY_TTL_SECONDS=86400

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Enable only when deployed behind a trusted proxy/LB that sets X-Forwarded-For.
TRUST_PROXY_X_FORWARDED_FOR=false

# --- auth / admin ----------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- observability / ops ---------------------------------------------------
METRICS_BEARER_TOKEN=
SENTRY_DSN=
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEGRADED_MODE=false
