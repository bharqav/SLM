# Keep the build context small and the image free of training state.
# Runtime weights are mounted from the host (see docker-compose.yml); they are
# never baked into the image.

# Version control and CI
.git
.gitignore
.github
.gitattributes

# Python caches and environments. Every pattern that has to match below the
# context root needs a `**/` prefix: Docker treats `*` as "within one path
# segment", so a bare `*.pt` drops only root-level checkpoints while
# `slm-training/*.pt` is still sent to the daemon. This repo carries multi-GB
# nested venvs under slm-training/ and slm-ft/, so the prefix is the
# difference between a ~20 MB context and a multi-GB one.
__pycache__
**/__pycache__
*.py[cod]
**/*.py[cod]
*.egg-info
**/*.egg-info
.eggs
**/.eggs
dist
build
.venv
**/.venv
slm-training/.venv
slm-ft/.venv
venv
env
.pytest_cache
**/.pytest_cache
.mypy_cache
**/.mypy_cache
.ruff_cache
**/.ruff_cache
.coverage
**/.coverage
htmlcov
**/htmlcov

# Model artifacts and training state (large; regenerated or mounted).
# The `**/` extension patterns drop the weights wherever they live, so the
# committed text artifacts next to them (preprocess_stats.json,
# benchmark_report.md, ...) stay in the image.
*.pt
**/*.pt
*.pth
**/*.pth
*.ckpt
**/*.ckpt
*.bin
**/*.bin
*.safetensors
**/*.safetensors
*.onnx
**/*.onnx
*.onnx.data
**/*.onnx.data
*.tokenizer.json
**/*.tokenizer.json
*.jsonl
**/*.jsonl
*.csv
**/*.csv
*.parquet
**/*.parquet
slm-training/losses.json
slm-training/training_stats.json
slm-training/train_log.json
slm-ft/adapter
slm-ft/adapter_stage2
slm-ft/merged_fp16
slm-ft/data
serving/*.log

# Development and test-only content
tests
notebooks
docs
*.ipynb
**/*.ipynb

# Local-only files
.env
**/.env
*.log
**/*.log
tmp_*
**/tmp_*
docker-compose.yml
docker-compose.prod.yml
.dockerignore
